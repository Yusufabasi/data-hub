# The app reads these from the process environment (it does not load .env itself).
# For local use: cp .env.example .env, edit, then `set -a; . ./.env; set +a`.
# Never commit .env. In production these live in the host's secret manager.

# SQLite file created by `data-hub-seed hub.db`
HUB_DB=hub.db

# Static demo bearer tokens: token -> user and role. Tokens need at least 8 characters.
# Roles: admin, finance, operations, viewer. Replace these fake values; use a real SSO in production.
HUB_TOKENS={"demo-finance-1":{"user":"amina","role":"finance"},"demo-viewer-1":{"user":"vera","role":"viewer"}}

# Anything other than "anthropic" uses the offline rule-based generator.
# "anthropic" uses a model and needs ANTHROPIC_API_KEY.
HUB_GENERATOR=rules
HUB_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
